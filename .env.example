# ==========================================
# CẤU HÌNH MÁY CHỦ HGC SOLAR ENGINE
# ==========================================

# Cổng chạy ứng dụng (Mặc định: 3000)
PORT=3000

# Môi trường chạy (development hoặc production)
NODE_ENV=production

# Đường dẫn URL của website (Tên miền hoặc IP máy chủ của bạn)
APP_URL="https://hgcvn.cloud"

# ==========================================
# CẤU HÌNH CƠ SỞ DỮ LIỆU POSTGRESQL (VPS)
# ==========================================
# Định dạng: postgres://<user>:<password>@<host>:<port>/<dbname>
# Mặc định trên VPS: postgres://postgres:mat_khau_cua_ban@localhost:5432/hgc_solar
DATABASE_URL="postgres://postgres:HgcSolar@2026@localhost:5432/hgc_solar"

# Khóa Gemini AI API (Tùy chọn)
GEMINI_API_KEY=""

# ==========================================
# CẤU HÌNH GỬI EMAIL OTP (SMTP NODEMAILER)
# ==========================================
# Nếu dùng Gmail: 
# 1. Bật xác thực 2 bước cho tài khoản Google
# 2. Vào https://myaccount.google.com/apppasswords tạo "Mật khẩu ứng dụng" 16 ký tự
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM='"HGC Solar" <your-email@gmail.com>'
